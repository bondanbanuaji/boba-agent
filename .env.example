# ========================================================
# GLOBAL ENVIRONMENT VARIABLES (ROOT)
# Copy file ini menjadi .env dan isi valuenya.
# File .env ini akan di-load secara otomatis oleh frontend & backend.
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND CONFIG
# --------------------------------------------------------
# URL API Backend untuk fetch
NEXT_PUBLIC_API_URL=http://localhost:3001

# DATABASE AUTH (Supabase) - Untuk auth di Frontend
NEXT_PUBLIC_SUPABASE_URL="isi_dengan_url_supabase_kamu"
NEXT_PUBLIC_SUPABASE_ANON_KEY="isi_dengan_anon_key_supabase_kamu"

# --------------------------------------------------------
# 2. BACKEND CONFIG
# --------------------------------------------------------
# Port Backend
PORT=3001
# URL Frontend (Untuk CORS)
FRONTEND_URL=http://localhost:4321

# KONEKSI DATABASE (PostgreSQL / Supabase direct URL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# KUNCI KEAMANAN LOKAL
# PENTING: Jika menggunakan Supabase, SUPABASE_JWT_SECRET HARUS sesuai dengan dashboard Supabase
SUPABASE_JWT_SECRET=isi_dengan_jwt_secret_dari_supabase
JWT_SECRET=super_secret_jwt_key_123
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_123

# MODEL AI & API KEYS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:20128/v1
DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct

# GOOGLE INTEGRATION (Opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# TELEGRAM & WHATSAPP (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WA_SESSION_SECRET=

# REDIS (Opsional)
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=
