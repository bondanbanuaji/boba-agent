# ========================================================
# BOBA-AGENT Global Environment Variables
# Copy this file to .env and fill in the values
# ========================================================

# --------------------------------------------------------
# 1. Database (Supabase / PostgreSQL)
# --------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# --------------------------------------------------------
# 2. Authentication (JWT)
# --------------------------------------------------------
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"

# --------------------------------------------------------
# 3. AI Core (Gemini)
# --------------------------------------------------------
GEMINI_API_KEY="your_google_ai_studio_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# --------------------------------------------------------
# 4. Google Workspace Integrations (OAuth2)
# --------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_cloud_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_cloud_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:3001/auth/google/callback"

# --------------------------------------------------------
# 5. Messaging Integrations (Telegram & WhatsApp)
# --------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_API_ID="your_telegram_api_id_here"
TELEGRAM_API_HASH="your_telegram_api_hash_here"

WA_SESSION_SECRET="your_whatsapp_session_secret_here"

# --------------------------------------------------------
# 6. Queue & Caching (Redis / BullMQ / Upstash)
# --------------------------------------------------------
UPSTASH_REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_TOKEN="your_upstash_token_here"

# --------------------------------------------------------
# 7. Web3 Integrations
# --------------------------------------------------------
PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"

# --------------------------------------------------------
# 8. Application Config
# --------------------------------------------------------
PORT="3001"
FRONTEND_URL="http://localhost:4321"
PUBLIC_API_URL="http://localhost:3001"
