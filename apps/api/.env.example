# ========================================================
# PENGATURAN BACKEND (API)
# Isi file ini dengan kunci rahasia (API Keys) milikmu
# ========================================================

# 1. PENGATURAN DASAR
# Biarkan port 3001 agar tidak tabrakan dengan aplikasi lain
PORT=3001
FRONTEND_URL=http://localhost:4321

# 2. DATABASE (PostgreSQL)
# Ganti "password" dengan password database Postgres kamu di komputer
DATABASE_URL=postgresql://postgres:password@localhost:5432/boba_agent

# 3. KUNCI KEAMANAN (Bisa diisi sembarang huruf acak untuk lokal)
JWT_SECRET=isi_dengan_bebas_misal_boba_keren_banget
JWT_REFRESH_SECRET=isi_dengan_bebas_juga

# 4. KECERDASAN BUATAN (AI)
# Opsional jika pakai 9Router
GEMINI_API_KEY=isi_api_key_gemini_dari_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# 5. KONEKSI KE 9ROUTER (Agen AI Lokal)
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_BASE_URL=http://localhost:20128/v1
DEFAULT_MODEL=nvidia/meta/llama-3.3-70b-instruct

# 6. KONEKSI GOOGLE (Untuk baca Gmail/Drive) - Opsional di awal
GOOGLE_CLIENT_ID=isi_client_id_dari_google_cloud
GOOGLE_CLIENT_SECRET=isi_client_secret_dari_google_cloud
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# 7. INTEGRASI PESAN (Telegram & WhatsApp) - Opsional di awal
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram
TELEGRAM_API_ID=isi_api_id_telegram
TELEGRAM_API_HASH=isi_api_hash_telegram
WA_SESSION_SECRET=isi_sembarang_huruf_acak_untuk_wa

# 8. CACHE & ANTRIAN (Redis) - Opsional jika belum butuh background job
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=kosongkan_jika_pakai_redis_lokal
