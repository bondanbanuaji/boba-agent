# ========================================================
# BOBA-AGENT Frontend Environment Variables (Astro)
# Copy this file to .env and fill in the values
# Note: Astro requires the PUBLIC_ prefix for variables 
# exposed to the client-side browser.
# ========================================================

# --------------------------------------------------------
# Application URLs
# --------------------------------------------------------
PUBLIC_API_URL="http://localhost:3001"

# --------------------------------------------------------
# Web3 Integrations
# --------------------------------------------------------
PUBLIC_WALLETCONNECT_PROJECT_ID="your_walletconnect_project_id_here"
