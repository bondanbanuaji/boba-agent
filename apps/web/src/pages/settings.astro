---
// Settings
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Settings - BOBA AGENT</title>
	</head>
	<body class="bg-slate-900 text-white p-8 max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold mb-8">Settings</h1>
        
        <div class="bg-slate-800 p-6 rounded-lg border border-slate-700 mb-6">
            <h2 class="text-xl font-bold mb-4">AI Configuration</h2>
            <div class="flex flex-col gap-4">
                <div>
                    <label class="block text-slate-400 mb-2">Model</label>
                    <select class="w-full p-2 bg-slate-900 border border-slate-700 rounded">
                        <option>gemini-2.5-flash</option>
                        <option>gemini-2.0-flash</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 mb-2">System Prompt</label>
                    <textarea class="w-full p-2 bg-slate-900 border border-slate-700 rounded h-32" placeholder="Custom instructions for the agent..."></textarea>
                </div>
                <button class="bg-blue-600 px-4 py-2 rounded font-bold self-start">Save Changes</button>
            </div>
        </div>

        <a href="/chat" class="block mt-8 text-blue-400 hover:underline">&larr; Back to Chat</a>
	</body>
</html>
